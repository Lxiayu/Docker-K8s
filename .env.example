# cp .env.example .env

# ---------- 数据库配置 ----------
POSTGRES_USER=cicd
POSTGRES_PASSWORD=cicd123
POSTGRES_DB=cicd_platform
POSTGRES_PORT=5432

# ---------- Redis 配置 ----------
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 后端配置 ----------
BACKEND_PORT=8080
SERVER_MODE=release
JWT_SECRET=change-me-in-production-at-least-32-chars

# ---------- 前端配置 ----------
FRONTEND_PORT=3000
